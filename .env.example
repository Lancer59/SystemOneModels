# Copy this file to .env and fill in your values.
# .env is gitignored — never commit the real one.

# OpenJev API key (for demo_openjev.py)
# Get yours at https://openjev.sh
OPENJEV_API_KEY=your_openjev_api_key_here

# TypeSafe / Jev API key (if using the real Jev API)
# Get yours at https://typesafe.ai
TYPESAFE_API_KEY=your_typesafe_api_key_here

# HuggingFace token (optional — removes rate limits on model downloads)
# Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here
